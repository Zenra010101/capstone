# Copy to server: /etc/gensanpos/gensanpos.env
# chmod 600 /etc/gensanpos/gensanpos.env

# --- Public site ---
# IP staging: see deploy/DEPLOY-IP.md and deploy/env/gensanpos.env.ip.example
GENSANPOS_PUBLIC_HOST=157.245.144.237
GENSANPOS_DOMAIN=pos.yourdomain.com
Cors__AllowedOrigins__0=https://pos.yourdomain.com

# --- PostgreSQL (localhost only — never expose port 5432 publicly) ---
ConnectionStrings__DefaultConnection=Host=127.0.0.1;Port=5432;Database=gensanpos;Username=gensanpos;Password=CHANGE_ME_STRONG_PASSWORD

# --- JWT (generate: openssl rand -base64 48) ---
Jwt__Secret=CHANGE_ME_LONG_RANDOM_SECRET
Jwt__Issuer=GensanPOS
Jwt__Audience=GensanPOS
Jwt__ExpirationHours=8

# --- ASP.NET ---
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5170

# --- Next.js (standalone) ---
PORT=3000
HOSTNAME=127.0.0.1
NODE_ENV=production
# Same-origin API via Nginx — leave empty at build time (see DEPLOY.md)
NEXT_PUBLIC_API_URL=

# --- GRS Phase 1 (keep false until explicit production activation approval) ---
ExchangeWorkflow__Phase1Enabled=false

# --- Seed ---
Seed__IncludeSampleProducts=false
# true only on first IP deploy; set false after 07-harden-accounts.sh
Seed__BootstrapDemoAccounts=false
