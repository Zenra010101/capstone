# IP-based staging — copy to /etc/gensanpos/gensanpos.env
# Generate secrets: bash deploy/scripts/00-generate-env.sh 157.245.144.237

# Public URL (switch to domain later — see deploy/DEPLOY-IP.md)
GENSANPOS_PUBLIC_HOST=157.245.144.237
GENSANPOS_DOMAIN=157.245.144.237
Cors__AllowedOrigins__0=http://157.245.144.237

# PostgreSQL (localhost only)
ConnectionStrings__DefaultConnection=Host=127.0.0.1;Port=5432;Database=gensanpos;Username=gensanpos;Password=REPLACE_WITH_GENERATED

# JWT
Jwt__Secret=REPLACE_WITH_GENERATED
Jwt__Issuer=GensanPOS
Jwt__Audience=GensanPOS
Jwt__ExpirationHours=8

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5170

PORT=3000
HOSTNAME=127.0.0.1
NODE_ENV=production
NEXT_PUBLIC_API_URL=

Seed__IncludeSampleProducts=false
# true only for first boot — creates owner/cashier with documented temp passwords
Seed__BootstrapDemoAccounts=true
